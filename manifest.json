{
  "manifest_version": 3,
  "name": "Direct Download Module",
  "version": "1.0.2",
  "description": "Download links, media and page links straight to your computer using the browser's own download engine. Works on Linux.",
  "minimum_chrome_version": "109",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Direct Download Module",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "permissions": [
    "downloads", "contextMenus", "webRequest", "webNavigation", "windows",
    "declarativeNetRequest", "storage", "tabs", "scripting", "clipboardWrite", "offscreen"
  ],
  "host_permissions": ["<all_urls>"]
}
